# M2 nixosTest (ADR 0011 topology): a `uchi` VM forwarding to a `soto` VM as its upstream, and a
# client VM, with `dig` as the oracle. The uchi's first upstream is the client, which never
# answers on port 53: every cache miss exercises the failover of ADR 0008. Covers RA/AA,
# max-ttl clamp, cache hits, negative caching, TCP fallback on TC, SERVFAIL when no upstream
# answers, the reverse zones of ADR 0005, the resolver module sending every name to annai, and
# the outputs of ADR 0011 on both servers: query log lines checked by nisshi, /metrics by masu.
{
  self,
  pkgs,
  validate,
}:
pkgs.testers.runNixOSTest {
  name = "annai-forwarding";

  nodes = {
    soto =
      { lib, ... }:
      {
        imports = [ self.nixosModules.default ];
        services.annai = {
          enable = true;
          mode = "soto";
          zones."example.net." = {
            ttl = 300;
            serial = 1;
            soa = {
              mname = "ns1.example.net.";
              rname = "hostmaster.example.net.";
              refresh = 3600;
              retry = 600;
              expire = 604800;
              minimum = 600;
            };
            names = {
              "@".ns = [ "ns1" ];
              ns1.a = [ "192.0.2.53" ];
              www.a = [ "192.0.2.80" ];
              # Over 1232 bytes: the uchi gets TC over UDP and must retry over TCP.
              big.txt = map (_: lib.concatStrings (lib.replicate 255 "x")) (lib.range 1 8);
            };
          };
        };
        networking.firewall.allowedUDPPorts = [ 53 ];
        networking.firewall.allowedTCPPorts = [ 53 ];
      };

    uchi =
      { nodes, ... }:
      {
        imports = [
          self.nixosModules.default
          ./example.nix
        ];
        services.annai.forwarding = {
          # The client drops the query (firewall): a timeout, then the soto over IPv6.
          upstreams = [
            nodes.client.networking.primaryIPAddress
            nodes.soto.networking.primaryIPv6Address
          ];
          maxTtl = 120;
        };
        services.annai.metrics.listen = "[::1]:9153";
        environment.systemPackages = [ pkgs.curl ];
        networking.firewall.allowedUDPPorts = [ 53 ];
        networking.firewall.allowedTCPPorts = [ 53 ];
      };

    client =
      { nodes, ... }:
      {
        imports = [ self.nixosModules.resolver ];
        environment.systemPackages = [ pkgs.dig ];
        services.annai.resolver = {
          enable = true;
          address = nodes.uchi.networking.primaryIPAddress;
          interface = "eth1";
          domain = "uchi.example.org";
        };
      };
  };

  testScript =
    { nodes, ... }:
    ''
      import re

      uchi4 = "${nodes.uchi.networking.primaryIPAddress}"

      def q(args):
          return client.succeed(f"dig @{uchi4} +time=8 +tries=1 {args}")

      def www_ttl(out):
          m = re.search(r"www\.example\.net\.\s+(\d+)\s+IN\s+A\s+192\.0\.2\.80", out)
          assert m, f"no www A record in: {out}"
          return int(m.group(1))

      def query_ms(out):
          m = re.search(r"Query time: (\d+) msec", out)
          assert m, f"no query time in: {out}"
          return int(m.group(1))

      for m in [soto, uchi]:
          m.wait_for_unit("annai.service")
          m.wait_for_open_port(53)
      client.wait_for_unit("multi-user.target")

      with subtest("local zones stay authoritative, with RA"):
          out = q("+noall +comments +answer hub.kekkai.uchi.example.org A")
          assert "flags: qr aa rd ra;" in out and "10.100.0.1" in out, out

      with subtest("reverse zones generated by the module"):
          out = q("+noall +comments +answer -x 10.100.0.1")
          assert "flags: qr aa rd ra;" in out and re.search(r"PTR\s+hub\.kekkai\.uchi\.example\.org\.", out), out
          for addr, name in [("10.100.0.3", "vm.kekkai.uchi.example.org."), ("fd12:3456:789a::1", "hub.kekkai.uchi.example.org.")]:
              out = q(f"+short -x {addr}")
              assert name in out, out
          # annai.uchi has an address in the range but is not a node: no PTR.
          out = q("+noall +comments -x 10.100.0.2")
          assert "status: NXDOMAIN" in out and "flags: qr aa rd ra;" in out, out

      with subtest("forwarded after failover: RA without AA, TTL clamped to max-ttl"):
          out = q("+noall +comments +answer +stats www.example.net A")
          assert "status: NOERROR" in out and "flags: qr rd ra;" in out, out
          first = www_ttl(out)
          assert 115 <= first <= 120, out
          assert query_ms(out) >= 1500, out  # the first upstream timed out (2 s)

      with subtest("the second query is a cache hit: immediate, TTL decremented"):
          client.sleep(2)
          out = q("+noall +answer +stats www.example.net A")
          assert www_ttl(out) < first and query_ms(out) < 1000, out

      with subtest("negative caching: NXDOMAIN with the SOA, TTL bounded by max-ttl"):
          out = q("+noall +comments +authority nope.example.net A")
          assert "status: NXDOMAIN" in out and re.search(r"example\.net\.\s+120\s+IN\s+SOA", out), out

      with subtest("TC from the upstream: retried over TCP, whole over TCP, truncated over UDP"):
          out = q("+tcp +noall +comments big.example.net TXT")
          assert "status: NOERROR" in out and "ANSWER: 8," in out and " tc" not in out, out
          out = q("+bufsize=1232 +ignore +noall +comments big.example.net TXT")
          assert "flags: qr tc rd ra;" in out, out

      with subtest("no upstream answers: the cache still serves, new names get SERVFAIL"):
          soto.succeed("systemctl stop annai.service")
          out = q("+short www.example.net A")
          assert "192.0.2.80" in out, out
          out = q("+noall +comments nope.example.net A")
          assert "status: NXDOMAIN" in out, out
          out = q("+noall +comments other.example.net A")
          assert "status: SERVFAIL" in out and "flags: qr rd ra;" in out, out
          soto.succeed("systemctl start annai.service")
          soto.wait_for_open_port(53)

      with subtest("the resolver module sends every name to annai"):
          client.wait_for_unit("annai-resolver.service")
          out = client.succeed("resolvectl query ns1.example.net")
          assert "192.0.2.53" in out, out
          for name, addr in [("ns1.example.net", "192.0.2.53"), ("hub", "10.100.0.1")]:
              out = client.succeed(f"getent ahostsv4 {name}")
              assert addr in out, out

      with subtest("logs (nisshi's schema) and metrics (masu's convention) of ADR 0011"):
          journal = "journalctl _SYSTEMD_UNIT=annai.service -o cat --no-pager"
          client4 = "${nodes.client.networking.primaryIPAddress}"
          soto6 = "${nodes.soto.networking.primaryIPv6Address}"
          uchi6 = "${nodes.uchi.networking.primaryIPv6Address}"
          out = uchi.succeed(journal)
          www = '"client":"' + client4 + '","qname":"www.example.net.","qtype":"A","rcode":"NOERROR","aa":false,"cache":'
          for needle in [www + '"miss"', www + '"hit"', '"qname":"other.example.net.","qtype":"A","rcode":"SERVFAIL"', '"event":"upstream-timeout","upstream":"' + client4 + ':53","qname":"www.example.net.","qtype":"A"', '"proto":"tcp"', '"cache":"none"']:
              assert needle in out, needle
          # The soto saw the uchi's forwarded queries, from its IPv6 address, lowercased.
          out = soto.succeed(journal)
          assert '"client":"' + uchi6 + '","qname":"www.example.net.","qtype":"A","rcode":"NOERROR","aa":true,"cache":"none"' in out, out
          for m in [soto, uchi]:
              m.succeed(f"{journal} | ${validate.logs} validate --logs")
          uchi.succeed("${validate.metrics} validate --metrics 'http://[::1]:9153/metrics'")

          def counter(name):
              out = uchi.succeed("curl -sfg 'http://[::1]:9153/metrics'")
              m = re.search(rf"^{re.escape(name)} (\d+)$", out, re.M)
              assert m, f"no {name} in: {out}"
              return int(m.group(1))

          assert counter('annai_cache_lookups_total{result="hit"}') >= 1
          assert counter('annai_upstream_queries_total{upstream="' + client4 + ':53",result="timeout"}') >= 1
          assert counter('annai_upstream_queries_total{upstream="[' + soto6 + ']:53",result="ok"}') >= 1
          series = 'annai_queries_total{proto="udp",qtype="A",rcode="NOERROR"}'
          before = counter(series)
          q("+short hub.kekkai.uchi.example.org A")
          assert counter(series) >= before + 1
    '';
}
